  "fields": {
    "listing_status": {
      "label": {
        "es": "¿Cuál es el estado actual de la propiedad?",
        "en": "What is the current status of your property?"
      },
      "type": "select",
      "required": true,
      "group": "stage",
      "options": [
        {
          "value": "not_published",
          "label": {
            "es": "Aún no está publicada",
            "en": "Not published"
          }
        },
        {
          "value": "preparing",
          "label": {
            "es": "Próxima a publicar",
            "en": "Preparing to publish"
          }
        },
        {
          "value": "active",
          "label": {
            "es": "Publicada y operando",
            "en": "Active"
          }
        },
        {
          "value": "relaunch",
          "label": {
            "es": "Relanzamiento / reposicionamiento",
            "en": "Relaunch / reposition"
          }
        }
      ]
    },
    "full_name": {
      "label": {
        "es": "Nombre completo",
        "en": "Full name"
      },
      "type": "text",
      "required": true,
      "group": "contact",
      "max_length": 120,
      "autocomplete": "name"
    },
    "email": {
      "label": {
        "es": "Correo electrónico",
        "en": "Email"
      },
      "type": "email",
      "required": true,
      "group": "contact",
      "max_length": 254,
      "autocomplete": "email"
    },
    "phone": {
      "label": {
        "es": "WhatsApp / teléfono",
        "en": "WhatsApp / phone"
      },
      "type": "tel",
      "required": true,
      "group": "contact",
      "max_length": 40,
      "autocomplete": "tel",
      "help": {
        "es": "Incluí el código de país. Ejemplo: +506 8888 1234.",
        "en": "Include your country code. Example: +506 8888 1234."
      }
    },
    "property_location": {
      "label": {
        "es": "Ubicación de la propiedad",
        "en": "Property location"
      },
      "type": "text",
      "required": true,
      "group": "project",
